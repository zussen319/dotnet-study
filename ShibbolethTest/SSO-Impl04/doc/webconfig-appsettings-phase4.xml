<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   フェーズ4：Web.config の appSettings の変更点

   ★このファイルはそのまま置き換えるものではありません。
     既存の <appSettings> を下記のとおり変更してください。
  =============================================================================
-->
<configuration>
  <appSettings>

    <!-- ====================================================================
         ★追加：署名鍵を保管している資格情報の名前

         この設定があると、Web.config ではなく
         Windows 資格情報マネージャーから署名鍵を取得する。

         ★資格情報は「利用者ごと」に保管される。
           アプリケーションプールの実行 ID で登録されている必要がある。
         ==================================================================== -->
    <add key="JwtSigningKeyTarget" value="PlmSsoDemo/JwtSigningKey" />

    <!-- ====================================================================
         ★削除：平文の署名鍵

         移行が確認できたら、この行を削除する。
         （移行の途中で切り戻したい場合に備え、まずコメントアウトでもよい）

         ！！残したままだと、Web.config を読めば鍵が分かる状態が続く！！
         ==================================================================== -->
    <!-- <add key="JwtSigningKey" value="plm-sso-demo-signing-key-change-me-32bytes!" /> -->

    <!-- ====================================================================
         ★確認：開発モードの設定

         フェーズ3の Web.config では、この設定が
         「上部で有効」「下部でコメントアウト」と二重に記述されていた。
         有効な行が残っていると、SP が何らかの理由で REMOTE_USER を
         セットできなかったときに、黙ってこの利用者として動作してしまう。

         SSO を検証・運用する環境では、有効な行を削除すること。
         ==================================================================== -->
    <!-- <add key="DevRemoteUser" value="01PLM01@plm-lab.local" /> -->

    <!-- ==== 以下はフェーズ3から変更なし ==== -->
    <add key="JwtIssuer" value="PlmSsoDemo" />
    <add key="JwtAudience" value="PlmSmartClient" />
    <add key="JwtLifetimeMinutes" value="30" />
    <add key="TicketLifetimeSeconds" value="60" />
    <add key="LogEnabled" value="true" />
    <add key="DiagEnabled" value="true" />

  </appSettings>
</configuration>
