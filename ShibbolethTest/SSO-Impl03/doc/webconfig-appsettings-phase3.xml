<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   フェーズ3：Web.config の appSettings に追加する設定（抜粋）

   ★このファイルはそのまま置き換えるものではありません。
     フェーズ2の Web.config の <appSettings> に、下記を追加してください。
     （他の節は変更不要）
  =============================================================================
-->
<configuration>
  <appSettings>

    <!-- ====================================================================
         JWT の署名鍵

         ★フェーズ3では固定値。フェーズ4で Windows 資格情報マネージャーからの
           取得に差し替える。（一度に変えると切り分けが難しくなるため段階を分ける）

         ★HS256 は 32 バイト（256bit）以上が必要。
           下記はデモ用の値なので、実際には推測されない値に変更すること。
         ==================================================================== -->
    <add key="JwtSigningKey" value="plm-sso-demo-signing-key-change-me-32bytes!" />

    <!-- 発行者・想定利用者（検証時に一致を確認する） -->
    <add key="JwtIssuer" value="PlmSsoDemo" />
    <add key="JwtAudience" value="PlmSmartClient" />

    <!-- JWT の有効分数。SmartClient は再取得しないため、作業時間を見込んで長めにする -->
    <add key="JwtLifetimeMinutes" value="30" />

    <!-- 引換券の有効秒数。ブラウザから SmartClient が起動するまでの時間だけあればよい -->
    <add key="TicketLifetimeSeconds" value="60" />

    <!-- ====================================================================
         ログ出力（デバッガをアタッチせずに処理を追うため）
         出力先の既定は App_Data\logs\plmsso-yyyyMMdd.log
         ★アプリケーションプールの ID に App_Data への書き込み権限が必要
         ==================================================================== -->
    <add key="LogEnabled" value="true" />
    <!-- 既定以外の場所に出す場合のみ指定する
    <add key="LogDirectory" value="C:\logs\plmsso" />
    -->

    <!-- ====================================================================
         診断エンドポイント /PLM/api/diag の有効化
         ★確認が済んだら false に戻すこと（設定状況が見えるため）
         ==================================================================== -->
    <add key="DiagEnabled" value="true" />

    <!-- ====================================================================
         開発モード（フェーズ2から継続）
         ★SSO の動作確認をする際は必ず削除するかコメントアウトすること
         ==================================================================== -->
    <!-- <add key="DevRemoteUser" value="01PLM01@plm-lab.local" /> -->

  </appSettings>
</configuration>
