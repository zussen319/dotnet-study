<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   PlmSsoDemo.Web / Web.config（フェーズ2）

   Visual Studio が生成したものに、次の3点を追加した完全版。
     (1) appSettings … 開発モード用の DevRemoteUser
     (2) system.web の authentication … 認証は Shibboleth SP が担当するため None
     (3) system.web の customErrors … 診断しやすくするため RemoteOnly

   ★ handlers（Web API 用）と assemblyBinding は生成されたものをそのまま使用。
     追加・変更していない。
  =============================================================================
-->
<configuration>

  <!-- ========================================================================
       (1) ★追加：アプリケーション設定
       ======================================================================== -->
  <appSettings>
    <!--
      開発モード用の設定。

      Shibboleth SP は IIS Express では動かないため、SP を経由しない環境では
      REMOTE_USER が空になる。この値を入れておくと、その場合にこの利用者として動作する。

      ！！SSO の動作確認をする際は、必ず削除するかコメントアウトすること！！
      残したままだと、SSO を経由しなくても誰でもこの利用者として振る舞えてしまう。
      （画面上部に警告が出るようにしてあるが、設定自体を消すのが確実）
    -->
    <add key="DevRemoteUser" value="01PLM01@plm-lab.local" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- ====================================================================
         (2) ★追加：認証は Shibboleth SP（IIS のネイティブモジュール）が担当する。
             ASP.NET 側でも認証を掛けると二重管理になり、動作が読みにくくなるため None。
         ==================================================================== -->
    <authentication mode="None" />

    <!-- ====================================================================
         (3) ★追加：エラーの詳細表示。
             RemoteOnly はサーバー上で直接見たときだけ詳細が出る設定。
             本番運用時は On（常にカスタムエラー）を推奨。
         ==================================================================== -->
    <customErrors mode="RemoteOnly" />

    <!-- ====================================================================
         (4) ★追加：文字コードの明示（重要）

         fileEncoding … ASP.NET が .aspx ファイルを読むときの文字コード。
           既定はサーバーのシステム既定コードページ（＝OS の言語設定に依存）。
           日本語ロケールでない Windows では、UTF-8 で書かれた .aspx 内の
           日本語が別の文字として解釈され、画面が文字化けする。
           （.cs はコンパイラが UTF-8 として読むため化けない。この差が
             「一部だけ文字化けする」という症状になる）

         requestEncoding / responseEncoding … 送受信の文字コード。

         ★OS の言語設定に依存しなくなるため、開発機・顧客環境が
           日本語版でも英語版でも同じ結果になる。
         ==================================================================== -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
      </controls>
    </pages>
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>

    <!--
      ★ClickOnce 用の MIME タイプ（.application / .manifest / .deploy）は
        ここには書かない。フェーズ1で IIS マネージャーの「MIME の種類」に
        登録済みであり、その設定が継承されるため。

        ここで <remove> を書くと、対象が存在しない場合に
        HTTP 500.19 の構成エラーになることがある。IIS 側で管理する方が安全。
    -->
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>

</configuration>
