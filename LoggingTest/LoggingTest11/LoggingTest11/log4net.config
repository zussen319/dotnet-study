<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	
	<!-- ============================================================ -->
	<!-- 出力先（Appender）の定義：ログの書き出し方法を設定 -->
	<!-- ============================================================ -->

	<!-- メインプログラム：標準のログファイル出力 -->
	<appender name="MainFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="logs/main.log" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<staticLogFileName value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
		</layout>
	</appender>

	<!-- API：相関ID(CorrelationId)を含むログファイル出力 -->
	<appender name="ApiFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="logs/api_service.log" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maxSizeRollBackups value="5" />
		<maximumFileSize value="10MB" />
		<staticLogFileName value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level [%property{CorrelationId}] - %message%newline" />
		</layout>
	</appender>

	<!-- ============================================================ -->
	<!-- 出力ルール（Root/Logger）の設定：どのロガーがどの出力先を使うか -->
	<!-- ============================================================ -->

	<!-- デフォルト設定：特定のloggerに該当しないものはすべて MainFileAppender に出力 -->
	<root>
		<level value="INFO" />
		<appender-ref ref="MainFileAppender" />
	</root>

	<!-- API専用設定：プログラム側で "ApiLogger" を指定して取得した場合に適用 -->
	<!--
		additivity="false" (加法性の抑制)：
		このロガーで出力したログを親(root)へ伝播させない設定。
		true（既定値）の場合、MainFileAppenderにも二重に出力されてしまうため false を指定。
	-->
	<logger name="ApiLogger" additivity="false">
		<level value="INFO" />
		<appender-ref ref="ApiFileAppender" />
	</logger>
</log4net>
